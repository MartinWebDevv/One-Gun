; Independent, offline prototype. Deliberately has no autoload section.
config_version=5

[application]
config/name="One Gun - Live Lobby Lab"
run/main_scene="res://lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="OneGunLiveLobbyLab"
run/flush_stdout_on_print=true

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.028, 0.037, 0.041, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/physics_engine="Jolt Physics"
